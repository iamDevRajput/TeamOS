# TeamOS Environment Configuration Template
# Copy to .env for local development. Never commit .env files.

NODE_ENV=development
PORT=3001
CORS_ORIGIN=http://localhost:3000

# PostgreSQL Database Connections (Local Docker Compose)
# 1. Migration / Schema Owner (DDL only - never runtime)
DATABASE_URL_MIGRATION=postgresql://teamos_owner:teamos_owner_password@localhost:5432/teamos?schema=public

# 2. API Runtime Connection (Least privilege, forced RLS, no DDL)
DATABASE_URL=postgresql://teamos_api_role:teamos_api_password@localhost:5432/teamos?schema=public

# 3. Worker Runtime Connection (Claim outbox + tenant RLS)
DATABASE_URL_WORKER=postgresql://teamos_worker_role:teamos_worker_password@localhost:5432/teamos?schema=public

# Placeholders for future milestones
# GITHUB_CLIENT_ID=placeholder_client_id
# GITHUB_CLIENT_SECRET=placeholder_client_secret
# GITHUB_APP_ID=placeholder_app_id
# GITHUB_APP_PRIVATE_KEY=placeholder_private_key
# GITHUB_WEBHOOK_SECRET=placeholder_webhook_secret
# SESSION_SECRET=placeholder_session_secret_at_least_32_chars
