datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL_MIGRATION")
}

generator client {
  provider = "prisma-client-js"
}

enum OrgRole {
  OWNER
  ADMIN
  MEMBER
}

enum TaskStatus {
  TODO
  IN_PROGRESS
  DONE
  CANCELLED
}

enum TaskPriority {
  URGENT
  HIGH
  MEDIUM
  LOW
}

enum ActorType {
  USER
  SYSTEM
  GITHUB
  AI
}

enum OutboxStatus {
  PENDING
  PROCESSING
  COMPLETED
  DEAD
}

enum ProposalKind {
  PLAN
  STATUS_CHANGE
}

enum ProposalState {
  PENDING
  APPROVED
  REJECTED
}

enum AiReservationState {
  RESERVED
  SETTLED
  RELEASED
  AWAITING_RECONCILIATION
}

model User {
  id           String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  githubUserId BigInt       @unique @map("github_user_id")
  login        String       @unique
  displayName  String?      @map("display_name")
  avatarUrl    String?      @map("avatar_url")
  createdAt    DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime     @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  memberships       Membership[]
  sessions          Session[]
  createdProjects   Project[]        @relation("ProjectCreator")
  createdTasks      Task[]           @relation("TaskCreator")
  createdDeps       TaskDependency[] @relation("DependencyCreator")
  createdInvitations Invitation[]   @relation("InvitationCreator")
  acceptedInvitations Invitation[]  @relation("InvitationAcceptor")
  createdProposals    Proposal[]    @relation("ProposalCreator")
  reviewedProposals   Proposal[]    @relation("ProposalReviewer")
  createdReports      ProjectReport[] @relation("ReportCreator")
  aiReservations      AiBudgetReservation[]
  githubInstallations GithubInstallation[] @relation("GithubInstallationCreator")
  taskComments        TaskComment[]
  createdMeetings     Meeting[]        @relation("MeetingCreator")
  assignedMeetingProposals MeetingActionProposal[] @relation("ProposalAssignee")
  notifications       Notification[]   @relation("UserNotifications")
  actorNotifications  Notification[]   @relation("NotificationActor")
  copilotMessages     CopilotMessage[]

  @@map("users")
}

model Session {
  id               String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId           String   @map("user_id") @db.Uuid
  sessionTokenHash String   @unique @map("session_token_hash")
  expiresAt        DateTime @map("expires_at") @db.Timestamptz(6)
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  lastActiveAt     DateTime @default(now()) @map("last_active_at") @db.Timestamptz(6)
  userAgent        String?  @map("user_agent") @db.VarChar(255)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([sessionTokenHash])
  @@index([userId])
  @@index([expiresAt])
  @@map("sessions")
}

model Organization {
  id                   String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name                 String
  slug                 String       @unique
  aiBudgetCentsMonthly Int          @default(0) @map("ai_budget_cents_monthly")
  createdAt            DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)

  memberships  Membership[]
  projects     Project[]
  tasks        Task[]
  dependencies TaskDependency[]
  auditEvents  AuditEvent[]
  outboxEvents OutboxEvent[]
  invitations  Invitation[]
  proposals    Proposal[]
  reports      ProjectReport[]
  aiReservations AiBudgetReservation[]
  githubInstallations GithubInstallation[]
  githubRepositories  GithubRepository[]
  taskComments        TaskComment[]
  taskGithubLinks     TaskGithubLink[]
  projectRiskHistory  ProjectRiskHistory[]
  meetings            Meeting[]
  transcriptSegments  TranscriptSegment[]
  meetingActionProposals MeetingActionProposal[]
  workspaceEmbeddings WorkspaceEmbedding[]
  notifications       Notification[]
  copilotMessages     CopilotMessage[]

  @@map("organizations")
}

model Membership {
  orgId     String   @map("org_id") @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  role      OrgRole  @default(MEMBER)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  organization Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  assignedTasks Task[]

  @@id([orgId, userId])
  @@map("memberships")
}

model Invitation {
  id         String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  orgId      String    @map("org_id") @db.Uuid
  tokenHash  String    @unique @map("token_hash")
  email      String?
  role       OrgRole   @default(MEMBER)
  createdBy  String    @map("created_by") @db.Uuid
  expiresAt  DateTime  @map("expires_at") @db.Timestamptz(6)
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  revokedAt  DateTime? @map("revoked_at") @db.Timestamptz(6)
  acceptedAt DateTime? @map("accepted_at") @db.Timestamptz(6)
  acceptedBy String?   @map("accepted_by") @db.Uuid

  organization Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  creator      User         @relation("InvitationCreator", fields: [createdBy], references: [id], onDelete: Restrict)
  acceptor     User?        @relation("InvitationAcceptor", fields: [acceptedBy], references: [id], onDelete: SetNull)

  @@unique([orgId, id], map: "uq_invitations_org_id_id")
  @@index([orgId])
  @@index([tokenHash])
  @@index([expiresAt])
  @@map("invitations")
}

model Project {
  id              String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  orgId           String   @map("org_id") @db.Uuid
  key             String
  name            String
  startDate       DateTime? @map("start_date") @db.Date
  dueDate         DateTime? @map("due_date") @db.Date
  timezone        String   @default("UTC")
  nextTaskNumber  Int      @default(1) @map("next_task_number")
  createdBy       String   @map("created_by") @db.Uuid
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  organization Organization     @relation(fields: [orgId], references: [id], onDelete: Cascade)
  creator      User             @relation("ProjectCreator", fields: [createdBy], references: [id], onDelete: Restrict)
  tasks        Task[]
  dependencies TaskDependency[]
  proposals    Proposal[]
  reports      ProjectReport[]
  githubRepositories GithubRepository[]
  riskHistory  ProjectRiskHistory[]
  meetings     Meeting[]
  meetingActionProposals MeetingActionProposal[]
  workspaceEmbeddings WorkspaceEmbedding[]
  copilotMessages CopilotMessage[]

  @@unique([orgId, id])
  @@unique([orgId, key])
  @@index([orgId])
  @@map("projects")
}

model Task {
  id                        String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  orgId                     String     @map("org_id") @db.Uuid
  projectId                 String     @map("project_id") @db.Uuid
  number                    Int
  title                     String
  description               String?
  status                    TaskStatus @default(TODO)
  priority                  TaskPriority @default(MEDIUM)
  assigneeId                String?    @map("assignee_id") @db.Uuid
  remainingEstimateWorkdays Int?       @map("remaining_estimate_workdays")
  dueDate                   DateTime?  @map("due_date") @db.Date
  version                   Int        @default(1)
  createdBy                 String     @map("created_by") @db.Uuid
  createdAt                 DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt                 DateTime   @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  organization Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  project      Project      @relation(fields: [orgId, projectId], references: [orgId, id], onDelete: Cascade)
  assignee     Membership?  @relation(fields: [orgId, assigneeId], references: [orgId, userId], onDelete: NoAction)
  creator      User         @relation("TaskCreator", fields: [createdBy], references: [id], onDelete: Restrict)

  blockedBy    TaskDependency[] @relation("BlockedTask")
  blocks       TaskDependency[] @relation("BlockerTask")
  comments     TaskComment[]
  githubLinks  TaskGithubLink[]
  convertedMeetingProposals MeetingActionProposal[] @relation("MeetingProposalConvertedTask")

  @@unique([orgId, id])
  @@unique([orgId, projectId, number])
  @@index([orgId, projectId])
  @@index([orgId, assigneeId])
  @@index([orgId, priority])
  @@map("tasks")
}

model TaskDependency {
  orgId         String   @map("org_id") @db.Uuid
  projectId     String   @map("project_id") @db.Uuid
  blockerTaskId String   @map("blocker_task_id") @db.Uuid
  blockedTaskId String   @map("blocked_task_id") @db.Uuid
  createdBy     String   @map("created_by") @db.Uuid
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  organization Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  project      Project      @relation(fields: [orgId, projectId], references: [orgId, id], onDelete: Cascade)
  blockerTask  Task         @relation("BlockerTask", fields: [orgId, blockerTaskId], references: [orgId, id], onDelete: Cascade)
  blockedTask  Task         @relation("BlockedTask", fields: [orgId, blockedTaskId], references: [orgId, id], onDelete: Cascade)
  creator      User         @relation("DependencyCreator", fields: [createdBy], references: [id], onDelete: Restrict)

  @@id([orgId, blockerTaskId, blockedTaskId])
  @@index([orgId, blockerTaskId])
  @@index([orgId, blockedTaskId])
  @@index([orgId, projectId])
  @@map("task_dependencies")
}

model AuditEvent {
  id         String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  orgId      String    @map("org_id") @db.Uuid
  actorType  ActorType @map("actor_type")
  actorId    String    @map("actor_id") @db.Uuid
  action     String
  entityType String    @map("entity_type")
  entityId   String    @map("entity_id") @db.Uuid
  beforeData Json?     @map("before_data")
  afterData  Json?     @map("after_data")
  requestId  String?   @map("request_id")
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  organization Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@index([orgId, entityType, entityId])
  @@index([orgId, createdAt])
  @@map("audit_events")
}

model OutboxEvent {
  id          String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  orgId       String       @map("org_id") @db.Uuid
  type        String
  payload     Json
  dedupeKey   String       @map("dedupe_key")
  status      OutboxStatus @default(PENDING)
  attempts    Int          @default(0)
  maxAttempts Int          @default(5) @map("max_attempts")
  availableAt DateTime     @default(now()) @map("available_at") @db.Timestamptz(6)
  lockedUntil DateTime?    @map("locked_until") @db.Timestamptz(6)
  lockedBy    String?      @map("locked_by")
  leaseToken  String?      @map("lease_token") @db.Uuid
  lastError   String?      @map("last_error")
  createdAt   DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  processedAt DateTime?    @map("processed_at") @db.Timestamptz(6)

  organization Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@unique([orgId, dedupeKey])
  @@index([status, availableAt])
  @@index([status, lockedUntil])
  @@map("outbox_events")
}

model Proposal {
  id              String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  orgId           String        @map("org_id") @db.Uuid
  projectId       String        @map("project_id") @db.Uuid
  kind            ProposalKind  @default(PLAN)
  state           ProposalState @default(PENDING)
  title           String
  description     String?
  payload         Json
  rejectionReason String?       @map("rejection_reason")
  createdBy       String        @map("created_by") @db.Uuid
  reviewedBy      String?       @map("reviewed_by") @db.Uuid
  createdAt       DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  reviewedAt      DateTime?     @map("reviewed_at") @db.Timestamptz(6)

  organization Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  project      Project      @relation(fields: [orgId, projectId], references: [orgId, id], onDelete: Cascade)
  creator      User         @relation("ProposalCreator", fields: [createdBy], references: [id], onDelete: Restrict)
  reviewer     User?        @relation("ProposalReviewer", fields: [reviewedBy], references: [id], onDelete: SetNull)

  @@unique([orgId, id], map: "uq_proposals_org_id_id")
  @@index([orgId])
  @@index([orgId, projectId])
  @@index([state])
  @@map("proposals")
}

model ProjectReport {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  orgId        String   @map("org_id") @db.Uuid
  projectId    String   @map("project_id") @db.Uuid
  title        String
  summary      String
  deliveryRisk String   @default("LOW") @map("delivery_risk")
  snapshotHash String   @map("snapshot_hash")
  snapshot     Json
  claims       Json
  createdBy    String   @map("created_by") @db.Uuid
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  organization Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  project      Project      @relation(fields: [orgId, projectId], references: [orgId, id], onDelete: Cascade)
  creator      User         @relation("ReportCreator", fields: [createdBy], references: [id], onDelete: Restrict)

  @@unique([orgId, id], map: "uq_project_reports_org_id_id")
  @@index([orgId])
  @@index([orgId, projectId])
  @@index([createdAt(sort: Desc)])
  @@map("project_reports")
}

model AiBudgetReservation {
  id                  String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  orgId               String             @map("org_id") @db.Uuid
  userId              String             @map("user_id") @db.Uuid
  idempotencyKey      String             @map("idempotency_key")
  reservedAmountCents Int                @map("reserved_amount_cents")
  settledAmountCents  Int?               @map("settled_amount_cents")
  state               AiReservationState @default(RESERVED)
  modelId             String             @map("model_id")
  periodKey           String             @map("period_key")
  errorMessage        String?            @map("error_message")
  createdAt           DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt           DateTime           @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  organization Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@unique([orgId, idempotencyKey], map: "uq_ai_reservations_org_idempotency")
  @@unique([orgId, id], map: "uq_ai_reservations_org_id_id")
  @@index([orgId, periodKey, state])
  @@index([orgId, createdAt(sort: Desc)])
  @@map("ai_budget_reservations")
}

model GithubInstallation {
  id                  String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  orgId               String   @map("org_id") @db.Uuid
  installationId      BigInt   @unique @map("installation_id")
  accountLogin        String   @map("account_login")
  accountId           BigInt   @map("account_id")
  accountType         String   @default("Organization") @map("account_type")
  repositorySelection String   @default("selected") @map("repository_selection")
  createdBy           String   @map("created_by") @db.Uuid
  createdAt           DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt           DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  organization Organization       @relation(fields: [orgId], references: [id], onDelete: Cascade)
  creator      User               @relation("GithubInstallationCreator", fields: [createdBy], references: [id], onDelete: Restrict)
  repositories GithubRepository[]

  @@unique([orgId, id], map: "uq_github_installations_org_id")
  @@unique([orgId, installationId], map: "uq_github_installations_org_installation")
  @@index([orgId])
  @@map("github_installations")
}

model GithubRepository {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  orgId          String   @map("org_id") @db.Uuid
  installationId BigInt   @map("installation_id")
  projectId      String?  @map("project_id") @db.Uuid
  repoId         BigInt   @map("repo_id")
  repoName       String   @map("repo_name")
  repoFullName   String   @map("repo_full_name")
  isPrivate      Boolean  @default(true) @map("is_private")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  organization Organization       @relation(fields: [orgId], references: [id], onDelete: Cascade)
  installation GithubInstallation @relation(fields: [installationId], references: [installationId], onDelete: Cascade)
  project      Project?           @relation(fields: [orgId, projectId], references: [orgId, id], onDelete: SetNull)

  @@unique([orgId, id], map: "uq_github_repos_org_id")
  @@unique([orgId, repoId], map: "uq_github_repos_org_repo")
  @@index([orgId, projectId])
  @@index([repoId])
  @@map("github_repositories")
}

model GithubWebhookDelivery {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  deliveryId  String    @unique @map("delivery_id")
  eventType   String    @map("event_type")
  action      String?
  payload     Json
  status      String    @default("PENDING")
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  processedAt DateTime? @map("processed_at") @db.Timestamptz(6)

  @@index([status, createdAt])
  @@map("github_webhook_deliveries")
}

model TaskComment {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  orgId     String   @map("org_id") @db.Uuid
  taskId    String   @map("task_id") @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  body      String   @db.Text
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  organization Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  task         Task         @relation(fields: [orgId, taskId], references: [orgId, id], onDelete: Cascade)
  author       User         @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@unique([orgId, id], map: "uq_task_comments_org_id")
  @@index([orgId, taskId])
  @@index([orgId, userId])
  @@map("task_comments")
}

model TaskGithubLink {
  id              String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  orgId           String   @map("org_id") @db.Uuid
  taskId          String   @map("task_id") @db.Uuid
  prNumber        Int      @map("pr_number")
  prTitle         String   @map("pr_title")
  prUrl           String   @map("pr_url")
  prBranch        String   @map("pr_branch")
  prState         String   @default("OPEN") @map("pr_state")
  isStalled       Boolean  @default(false) @map("is_stalled")
  lastActivityAt  DateTime @default(now()) @map("last_activity_at") @db.Timestamptz(6)
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  organization Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  task         Task         @relation(fields: [orgId, taskId], references: [orgId, id], onDelete: Cascade)

  @@unique([orgId, id], map: "uq_task_github_links_org_id")
  @@unique([orgId, taskId, prNumber], map: "uq_task_github_links_org_task_pr")
  @@index([orgId, taskId])
  @@map("task_github_links")
}

model ProjectRiskHistory {
  id                     String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  orgId                  String    @map("org_id") @db.Uuid
  projectId              String    @map("project_id") @db.Uuid
  snapshotDate           DateTime  @map("snapshot_date") @db.Date
  targetDate             DateTime? @map("target_date") @db.Date
  forecastDate           DateTime? @map("forecast_date") @db.Date
  scheduleVarianceDays   Int       @default(0) @map("schedule_variance_days")
  criticalPathDuration   Int       @default(0) @map("critical_path_duration")
  criticalTaskCount      Int       @default(0) @map("critical_task_count")
  riskLevel              String    @default("LOW") @map("risk_level")
  snapshotHash           String    @map("snapshot_hash")
  createdAt              DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  organization Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  project      Project      @relation(fields: [orgId, projectId], references: [orgId, id], onDelete: Cascade)

  @@unique([orgId, id], map: "uq_project_risk_history_org_id")
  @@unique([orgId, projectId, snapshotDate], map: "uq_project_risk_history_org_project_date")
  @@index([orgId, projectId, snapshotDate], map: "project_risk_history_lookup_idx")
  @@map("project_risk_history")
}

model Meeting {
  id              String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  orgId           String   @map("org_id") @db.Uuid
  projectId       String   @map("project_id") @db.Uuid
  title           String
  meetingDate     DateTime @default(now()) @map("meeting_date") @db.Timestamptz(6)
  participants    String[] @default([])
  audioUrl        String?  @map("audio_url")
  transcript      String?  @db.Text
  status          String   @default("COMPLETED")
  createdByUserId String?  @map("created_by_user_id") @db.Uuid
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  organization    Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  project         Project      @relation(fields: [orgId, projectId], references: [orgId, id], onDelete: Cascade)
  createdByUser   User?        @relation("MeetingCreator", fields: [createdByUserId], references: [id], onDelete: SetNull)

  transcriptSegments TranscriptSegment[]
  actionProposals    MeetingActionProposal[]

  @@unique([orgId, id], map: "uq_meetings_org_id")
  @@index([orgId, projectId, meetingDate(sort: Desc)])
  @@map("meetings")
}

model TranscriptSegment {
  id               String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  orgId            String   @map("org_id") @db.Uuid
  meetingId        String   @map("meeting_id") @db.Uuid
  speaker          String
  startTimeSeconds Float    @map("start_time_seconds")
  endTimeSeconds   Float    @map("end_time_seconds")
  text             String   @db.Text
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  organization Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  meeting      Meeting      @relation(fields: [orgId, meetingId], references: [orgId, id], onDelete: Cascade)

  @@unique([orgId, id], map: "uq_transcript_segments_org_id")
  @@index([orgId, meetingId])
  @@map("transcript_segments")
}

model MeetingActionProposal {
  id                  String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  orgId               String    @map("org_id") @db.Uuid
  projectId           String    @map("project_id") @db.Uuid
  meetingId           String    @map("meeting_id") @db.Uuid
  actionItem          String    @map("action_item") @db.Text
  suggestedAssigneeId String?   @map("suggested_assignee_id") @db.Uuid
  suggestedDeadline   DateTime? @map("suggested_deadline") @db.Timestamptz(6)
  confidence          Float     @default(0.9)
  supportingEvidence  String?   @map("supporting_evidence") @db.Text
  status              String    @default("PENDING")
  convertedTaskId     String?   @map("converted_task_id") @db.Uuid
  createdAt           DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt           DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  organization      Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  project           Project      @relation(fields: [orgId, projectId], references: [orgId, id], onDelete: Cascade)
  meeting           Meeting      @relation(fields: [orgId, meetingId], references: [orgId, id], onDelete: Cascade)
  suggestedAssignee User?        @relation("ProposalAssignee", fields: [suggestedAssigneeId], references: [id], onDelete: SetNull)
  convertedTask     Task?        @relation("MeetingProposalConvertedTask", fields: [orgId, convertedTaskId], references: [orgId, id], onDelete: SetNull)

  @@unique([orgId, id], map: "uq_meeting_action_proposals_org_id")
  @@index([orgId, meetingId, status])
  @@map("meeting_action_proposals")
}

model WorkspaceEmbedding {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  orgId       String   @map("org_id") @db.Uuid
  projectId   String?  @map("project_id") @db.Uuid
  sourceType  String   @map("source_type")
  sourceId    String   @map("source_id") @db.Uuid
  chunkIndex  Int      @default(0) @map("chunk_index")
  contentText String   @map("content_text") @db.Text
  embedding   Unsupported("vector(768)")?
  metadata    Json     @default("{}")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  organization Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  project      Project?     @relation(fields: [orgId, projectId], references: [orgId, id], onDelete: Cascade)

  @@unique([orgId, id], map: "uq_workspace_embeddings_org_id")
  @@index([orgId, projectId, sourceType])
  @@map("workspace_embeddings")
}

model Notification {
  id         String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  orgId      String    @map("org_id") @db.Uuid
  userId     String    @map("user_id") @db.Uuid
  actorId    String?   @map("actor_id") @db.Uuid
  type       String
  title      String
  body       String
  entityType String    @map("entity_type")
  entityId   String    @map("entity_id") @db.Uuid
  readAt     DateTime? @map("read_at") @db.Timestamptz(6)
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  organization Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  user         User         @relation("UserNotifications", fields: [userId], references: [id], onDelete: Cascade)
  actor        User?        @relation("NotificationActor", fields: [actorId], references: [id], onDelete: SetNull)

  @@unique([orgId, id], map: "uq_notifications_org_id")
  @@index([orgId, userId, readAt, createdAt(sort: Desc)])
  @@map("notifications")
}

model CopilotMessage {
  id                String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  orgId             String   @map("org_id") @db.Uuid
  projectId         String   @map("project_id") @db.Uuid
  userId            String   @map("user_id") @db.Uuid
  role              String
  content           String   @db.Text
  simulationPayload Json?    @map("simulation_payload")
  citations         Json     @default("[]")
  createdAt         DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  organization Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  project      Project      @relation(fields: [orgId, projectId], references: [orgId, id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([orgId, id], map: "uq_copilot_messages_org_id")
  @@index([orgId, projectId, createdAt(sort: Asc)])
  @@map("copilot_messages")
}
